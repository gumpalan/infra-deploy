# Konfigurasi Lingkungan Production svc-auth
# Lokasi umum: /etc/gumpalan/auth.env

PORT=8001

# Pilihan database: sqlite | mysql | mariadb | pgsql
DB_CONNECTION=sqlite
DB_DATABASE=/var/lib/gumpalan/auth.db
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=disable
DB_AUTO_MIGRATE=true

# Contoh untuk MariaDB:
# DB_CONNECTION=mariadb
# DB_DATABASE=gumpalan_auth
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USERNAME=gumpalan
# DB_PASSWORD=ganti_password_ini

# Contoh untuk PostgreSQL:
# DB_CONNECTION=pgsql
# DB_DATABASE=gumpalan_auth
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USERNAME=gumpalan
# DB_PASSWORD=ganti_password_ini
# DB_SSLMODE=disable
