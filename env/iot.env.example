# Konfigurasi Lingkungan Production svc-iot
# Lokasi umum: /etc/gumpalan/iot.env

PORT=8002

# Pilihan database: sqlite | mysql | mariadb | pgsql
DB_CONNECTION=sqlite
DB_DATABASE=/var/lib/gumpalan/iot.db
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=disable
DB_AUTO_MIGRATE=true

# Alamat broker MQTT lokal
MQTT_BROKER=tcp://127.0.0.1:1883
MQTT_CLIENT_ID=gumpalan_svc_iot
MQTT_USERNAME=gumpalan_svc_iot
MQTT_PASSWORD=ganti_password_mqtt_ini

# Contoh untuk MariaDB:
# DB_CONNECTION=mariadb
# DB_DATABASE=gumpalan_iot
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USERNAME=gumpalan
# DB_PASSWORD=ganti_password_ini

# Contoh untuk PostgreSQL:
# DB_CONNECTION=pgsql
# DB_DATABASE=gumpalan_iot
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USERNAME=gumpalan
# DB_PASSWORD=ganti_password_ini
# DB_SSLMODE=disable
